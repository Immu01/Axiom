# Axiom Backend Environment Configuration Template
# Copy this file to .env and populate your API keys.

# ==============================================================================
# AI Provider API Keys (Supports comma-separated keys for pool rotation)
# ==============================================================================
# Groq Cloud API Keys: https://console.groq.com/keys
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2

# Google Gemini API Keys: https://aistudio.google.com/
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# OpenRouter API Keys: https://openrouter.ai/keys
OPENROUTER_API_KEYS=your_openrouter_api_key_1,your_openrouter_api_key_2

# ==============================================================================
# Agentic Web Search (Tavily API)
# ==============================================================================
# Tavily Search API Keys: https://tavily.com/
TAVILY_API_KEYS=your_tavily_api_key_1,your_tavily_api_key_2

# ==============================================================================
# Primary Model Overrides (Optional - defaults to verified free high-capacity models)
# ==============================================================================
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# ==============================================================================
# Orchestration & Failover Tuning (Optional)
# ==============================================================================
# Cascade priority order (comma-separated provider names)
PROVIDER_ORDER=groq,gemini,openrouter

# Providers designated for multimodal vision queries
VISION_PROVIDERS=gemini,groq,openrouter

# Timeouts in seconds
FIRST_TOKEN_TIMEOUT=8.0
NEXT_TOKEN_TIMEOUT=20.0
